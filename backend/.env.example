FLASK_ENV=development

# YOLO
YOLO_MODEL_PATH=models/best.pt
YOLO_DEVICE=cpu
YOLO_MIN_CONFIDENCE=0.25
YOLO_IOU=0.45
YOLO_CLASSES=person
VIDEO_FRAME_STRIDE=15

# At or above this a detection is trusted; below it a human reviews it.
CONFIDENCE_THRESHOLD=0.85

CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
